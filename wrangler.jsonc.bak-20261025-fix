{
  // MIGRATED Pages -> Workers 2026-08-01. Same root cause as 1210cedar:
  // @opennextjs/cloudflare ^1.18.1 dropped Cloudflare Pages support and emits a
  // Workers module entry (.open-next/worker.js importing ./cloudflare/*.js and
  // ./middleware/handler.mjs), NOT a Pages _worker.js. The old
  // "pages_build_output_dir" config was stale against its own dependency, so a
  // `wrangler pages deploy .open-next/assets` ships STATIC FILES WITH NO WORKER
  // and every API route returns 405. Verified on production and rolled back.
  // Previous Pages config: wrangler.jsonc.bak-pages-20260801
  "name": "66anthony-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
